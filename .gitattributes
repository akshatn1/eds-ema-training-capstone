# Enforce LF line endings for source files so Windows CRLF checkouts
# don't break ESLint/Stylelint (linebreak-style / no-missing-end-of-source-newline).

*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Vendored file — do not normalize or convert line endings.
scripts/aem.js -text -eol

# Binary assets — never apply text/EOL conversion.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.eot   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.svg   text eol=lf
